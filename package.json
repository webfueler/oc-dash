{
  "name": "@webfueler/oc-dash",
  "version": "0.1.7",
  "description": "Local dashboard for opencode2 session costs, token totals, and subagent spend",
  "license": "MIT",
  "repository": "https://github.com/webfueler/oc-dash",
  "homepage": "https://github.com/webfueler/oc-dash",
  "author": "webfueler",
  "keywords": [
    "opencode",
    "opencode2",
    "cost",
    "tokens",
    "spend",
    "dashboard"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "oc-dash": "bin/oc-dash.js"
  },
  "files": [
    "bin",
    "dist",
    "dist-server",
    "docs/screenshot.png"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/index.js",
    "test": "vitest run",
    "lint": "eslint .",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@opencode/client": "0.0.0-beta-19296",
    "hono": "^4.13.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
